HOST=0.0.0.0
PORT=8086
API_TOKEN=change-me

# Local job/output paths on the Linux server.
WORK_DIR=./storage/work
OUTPUT_DIR=./storage/output
PUBLIC_BASE_URL=http://localhost:8086

# Edge-TTS must be executable by the same Linux user that runs this service.
# If PM2/systemd runs as a non-root user, install Edge-TTS for that user and use its path.
EDGE_TTS_BIN=edge-tts
OPENVOICE_PYTHON=/root/miniconda3/envs/openvoice/bin/python
OPENVOICE_SCRIPT=./scripts/openvoice_tts.py
OPENVOICE_DIR=/www/wwwroot/default/OpenVoice
OPENVOICE_REFERENCE_AUDIO_PATH=/www/wwwroot/default/voices/demo_man.wav
VIDEO_ALLOW_SILENT_TTS=0

# Optional Cloudflare R2 upload. If omitted, videos are served by this API from OUTPUT_DIR.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://cdn.example.com
